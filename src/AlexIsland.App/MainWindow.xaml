<UserControl
    x:Class="AlexIsland.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fondo transparente: la ventana de la isla (IslandHostWindow) se compone
         con transparencia por píxel, así que alrededor del notch se ve el escritorio
         y sus curvas quedan suavizadas. -->
    <Grid x:Name="RootGrid">
        <!-- Escala elegida por el usuario en Ajustes; la ventana se ajusta al mismo factor. -->
        <Grid.RenderTransform>
            <ScaleTransform x:Name="NotchUserScale" ScaleX="1" ScaleY="1" CenterX="0" CenterY="0"/>
        </Grid.RenderTransform>
        <Grid x:Name="IslandContainer"
              Width="196"
              Height="36"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              AllowDrop="True"
              DragEnter="IslandContainer_DragEnter"
              DragOver="IslandContainer_DragOver"
              DragLeave="IslandContainer_DragLeave"
              Drop="IslandContainer_Drop"
              PointerEntered="IslandContainer_PointerEntered"
              PointerExited="IslandContainer_PointerExited"
              Tapped="IslandContainer_Tapped">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <!-- Sombra difuminada (DropShadow de composición con la silueta del notch como máscara) -->
            <Canvas x:Name="NotchShadowHost" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- Fondo azul marino con silueta exacta del Notch de Mac (con orejas cóncavas y esquinas redondeadas) -->
            <Path x:Name="NotchBackground"
                  Fill="#FF032539"
                  Stroke="#1FFBF3F2"
                  StrokeThickness="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"/>

            <!-- Modo 1: Resting. Mascota: los ojos rasgados del zorro de Alex Island,
                 en el naranja de la marca (#FA991C).
                 Parpadean de vez en cuando y, tras un rato sin actividad, se cierran (duerme). -->
            <Grid x:Name="RestingContent" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32">
                <!-- Resplandor cálido detrás de los ojos, como en el logo -->
                <Ellipse x:Name="FoxEyesGlow" Width="46" Height="22" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66FA991C" Offset="0"/>
                            <GradientStop Color="#26FA991C" Offset="0.55"/>
                            <GradientStop Color="#00FA991C" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Polygon x:Name="LeftEye" Points="0,0 4,1.2 10,8 5,6.4" Width="10" Height="8">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFD08F" Offset="0"/>
                                <GradientStop Color="#FFFFB04A" Offset="0.5"/>
                                <GradientStop Color="#FFFA991C" Offset="1"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.RenderTransform>
                            <ScaleTransform x:Name="LeftEyeScale" CenterX="5" CenterY="4"/>
                        </Polygon.RenderTransform>
                    </Polygon>
                    <Polygon x:Name="RightEye" Points="10,0 6,1.2 0,8 5,6.4" Width="10" Height="8">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFD08F" Offset="0"/>
                                <GradientStop Color="#FFFFB04A" Offset="0.5"/>
                                <GradientStop Color="#FFFA991C" Offset="1"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.RenderTransform>
                            <ScaleTransform x:Name="RightEyeScale" CenterX="5" CenterY="4"/>
                        </Polygon.RenderTransform>
                    </Polygon>
                </StackPanel>
            </Grid>

            <!-- Modo 2: Closed (Contenido compacto con anillo de progreso circular estilo Nusa) -->
            <Grid x:Name="CompactContent" Margin="14,0,14,0" Height="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Anillo de progreso circular en vivo estilo Nusa -->
                    <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="1,0,3,0">
                        <Ellipse Width="14" Height="14" Stroke="#26FBF3F2" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="CompactProgressArc" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None"
                              Stroke="#FFFA991C" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse x:Name="CompactCenterDot" Width="4" Height="4" Fill="#FFFA991C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Badge de Pomodoro / Focus activo en modo compacto -->
                    <Border x:Name="CompactPomodoroBadge"
                            Visibility="Collapsed"
                            Background="#FF2B2A3A"
                            BorderBrush="#FFFA991C"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="3,1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="CompactPomodoroIcon" Text="🍅" FontSize="8.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompactPomodoroText" Text="25:00" Foreground="#FFFA991C" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Badge sutil de reunión próxima en modo compacto -->
                    <Border x:Name="CompactMeetingBadge"
                            Visibility="Collapsed"
                            Background="#FF283635"
                            BorderBrush="#FFFA991C"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="3,1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE717;" FontSize="8.5" Foreground="#FFFA991C"/>
                            <TextBlock x:Name="CompactMeetingText" Text="10:00" Foreground="#FFFA991C" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Badge sutil de backlog pendiente en modo compacto -->
                    <Border x:Name="CompactTaskBadge"
                            Visibility="Collapsed"
                            Background="#FF114059"
                            CornerRadius="4"
                            Padding="3,1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="8.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompactTaskCount" Text="0" Foreground="#FFB8CBD3" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Centro Dinámico: Título en negrita blanca y subtítulo de estado o reloj -->
                <Grid x:Name="CompactCenterContainer"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      Tapped="CompactCenter_Tapped"
                      Padding="2,0"
                      ToolTipService.ToolTip="Clic para alternar entre hora e información de reproducción/enfoque">
                    
                    <!-- 1. Reloj digital elegante -->
                    <TextBlock x:Name="CompactClock"
                               Text="13:40"
                               Foreground="#FFFBF3F2"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <!-- 2. Información multimedia dinámica: Título en negrita blanca + Subtítulo de artista -->
                    <StackPanel x:Name="CompactMediaInfo"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="0.5"
                                MaxWidth="150"
                                Visibility="Visible">
                        <TextBlock x:Name="CompactTrackTitle"
                                   Text="No hay reproducción activa"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFBF3F2"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                        <TextBlock x:Name="CompactTrackArtist"
                                   Text="Windows Media Session"
                                   FontSize="9"
                                   Foreground="#FFB8CBD3"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                    </StackPanel>

                    <!-- 3. Información de Pomodoro / Enfoque -->
                    <StackPanel x:Name="CompactFocusInfo"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="0.5"
                                MaxWidth="150"
                                Visibility="Collapsed">
                        <TextBlock x:Name="CompactFocusTitle"
                                   Text="Enfoque Activo"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFA991C"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                        <TextBlock x:Name="CompactFocusTime"
                                   Text="25:00"
                                   FontSize="9"
                                   Foreground="#FFB8CBD3"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxLines="1"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="WaveformPanel" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,2,0">
                    <Border x:Name="WaveBar1" Width="2" Height="16" Background="#FFFA991C" CornerRadius="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="WaveBar1Scale" ScaleY="0.35"/></Border.RenderTransform></Border>
                    <Border x:Name="WaveBar2" Width="2" Height="16" Background="#FFFA991C" CornerRadius="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="WaveBar2Scale" ScaleY="0.7"/></Border.RenderTransform></Border>
                    <Border x:Name="WaveBar3" Width="2" Height="16" Background="#FFFA991C" CornerRadius="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="WaveBar3Scale" ScaleY="0.9"/></Border.RenderTransform></Border>
                    <Border x:Name="WaveBar4" Width="2" Height="16" Background="#FFFA991C" CornerRadius="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="WaveBar4Scale" ScaleY="0.45"/></Border.RenderTransform></Border>
                </StackPanel>
            </Grid>

            <!-- Modo 3: Peek (Notificación emergente de Hardware / Auriculares / Batería estilo Nusa) -->
            <Grid x:Name="PeekContent" Visibility="Collapsed" Margin="16,0,16,0" Height="42" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Izquierda: Anillo de batería/estado con icono Bluetooth/Rayo -->
                <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse Width="22" Height="22" Fill="#1EFBF3F2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="20" Height="20" Stroke="#28FBF3F2" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Path x:Name="PeekProgressArc" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None"
                          Stroke="#FF5DB3CC" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <FontIcon x:Name="PeekIcon" Glyph="&#xE702;" FontSize="10" Foreground="#FFFBF3F2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Centro-Izquierda: Título y subtítulo con espaciado respirable -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1.5">
                    <TextBlock x:Name="PeekTitle" Text="AirBuds Pro" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFBF3F2" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    <TextBlock x:Name="PeekSubtitle" Text="Connected · 70%" FontSize="10" Foreground="#FFB8CBD3" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                </StackPanel>

                <!-- Derecha: Icono de periférico con ondas concéntricas de sonido -->
                <Grid Grid.Column="2" Width="28" Height="28" VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- Halo difuminado con el color del aviso (se asigna en código) -->
                    <Ellipse x:Name="PeekGlow" Width="44" Height="44" Margin="-8" IsHitTestVisible="False"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse x:Name="PeekRippleOuter" Width="28" Height="28" Stroke="#225DB3CC" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                    <Ellipse x:Name="PeekRippleInner" Width="21" Height="21" Stroke="#445DB3CC" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                    <Ellipse Width="17" Height="17" Fill="#1E5DB3CC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <FontIcon x:Name="PeekRightIcon" Glyph="&#xE7F6;" FontSize="10.5" Foreground="#FF5DB3CC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Contenido expandido sutil, compacto y elegante estilo Dynamic Island de Mac -->
            <Grid x:Name="ExpandedContent" Visibility="Collapsed" Opacity="0" Margin="18,6,18,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Fila 0: cabecera. Pestañas con ícono y nombre a la izquierda (la activa en una píldora);
                     a la derecha, la hora y el acceso a Ajustes. -->
                <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style x:Key="IslandTabButtonStyle" TargetType="Button">
                            <Setter Property="CornerRadius" Value="13"/>
                            <Setter Property="Padding" Value="7,0"/>
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </Grid.Resources>

                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center"
                                PointerWheelChanged="TabBar_PointerWheelChanged" Background="Transparent">
                        <Button x:Name="TabMediaButton" Click="TabMediaButton_Click" Style="{StaticResource IslandTabButtonStyle}" Background="#FF1C768F">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon x:Name="TabMediaIcon" Glyph="&#xE80F;" FontSize="12" Foreground="#FFFBF3F2"/>
                                    <TextBlock x:Name="TabMediaLabel" Text="Inicio" FontSize="10.5" Foreground="#FFFBF3F2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="TabCalendarButton" Click="TabCalendarButton_Click" Style="{StaticResource IslandTabButtonStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon x:Name="TabCalendarIcon" Glyph="&#xE787;" FontSize="12" Foreground="#FF8FA9B5"/>
                                    <TextBlock x:Name="TabCalendarLabel" Text="Agenda" FontSize="10.5" Foreground="#FF8FA9B5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border x:Name="HeaderCalendarBadge" Visibility="Collapsed" Background="#33FBF3F2" CornerRadius="7" Padding="5,0" MinWidth="16" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderCalendarCount" Text="0" FontSize="10" Foreground="#FFFBF3F2" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <Ellipse x:Name="TabCalendarDot" Visibility="Collapsed" Width="6" Height="6" Fill="#FFFA991C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-6,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="TabPlannerButton" Click="TabPlannerButton_Click" Style="{StaticResource IslandTabButtonStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon x:Name="TabPlannerIcon" Glyph="&#xE70B;" FontSize="12" Foreground="#FF8FA9B5"/>
                                    <TextBlock x:Name="TabPlannerLabel" Text="Planner" FontSize="10.5" Foreground="#FF8FA9B5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="TabBacklogButton" Click="TabBacklogButton_Click" Style="{StaticResource IslandTabButtonStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon x:Name="TabBacklogIcon" Glyph="&#xE9D5;" FontSize="12" Foreground="#FF8FA9B5"/>
                                    <TextBlock x:Name="TabBacklogLabel" Text="Tareas" FontSize="10.5" Foreground="#FF8FA9B5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border x:Name="HeaderBacklogBadge" Visibility="Collapsed" Background="#33FBF3F2" CornerRadius="7" Padding="5,0" MinWidth="16" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderBacklogCount" Text="0" FontSize="10" Foreground="#FFFBF3F2" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="TabPomodoroButton" Click="TabPomodoroButton_Click" Style="{StaticResource IslandTabButtonStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon x:Name="TabPomodoroIcon" Glyph="&#xE916;" FontSize="12" Foreground="#FF8FA9B5"/>
                                    <TextBlock x:Name="TabPomodoroLabel" Text="Enfoque" FontSize="10.5" Foreground="#FF8FA9B5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border x:Name="HeaderPomodoroBadge" Visibility="Collapsed" Background="#33FBF3F2" CornerRadius="7" Padding="5,0" MinWidth="16" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderPomodoroCount" Text="0" FontSize="10" Foreground="#FFFBF3F2" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <Ellipse x:Name="TabPomodoroDot" Visibility="Collapsed" Width="6" Height="6" Fill="#FFFA991C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-6,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="TabSystemButton" Click="TabSystemButton_Click" Style="{StaticResource IslandTabButtonStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon x:Name="TabSystemIcon" Glyph="&#xE9D9;" FontSize="12" Foreground="#FF8FA9B5"/>
                                    <TextBlock x:Name="TabSystemLabel" Text="Sistema" FontSize="10.5" Foreground="#FF8FA9B5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="TabShelfButton" Click="TabShelfButton_Click" Style="{StaticResource IslandTabButtonStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon x:Name="TabShelfIcon" Glyph="&#xE7B8;" FontSize="12" Foreground="#FF8FA9B5"/>
                                    <TextBlock x:Name="TabShelfLabel" Text="Archivos" FontSize="10.5" Foreground="#FF8FA9B5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border x:Name="HeaderShelfBadge" Visibility="Collapsed" Background="#33FBF3F2" CornerRadius="7" Padding="5,0" MinWidth="16" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderShelfCount" Text="0" FontSize="10" Foreground="#FFFBF3F2" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="HeaderClock" Grid.Column="2" Text="09:14" VerticalAlignment="Center"
                               Foreground="#FF8FA9B5" FontSize="11" FontWeight="SemiBold"/>
                    <Button x:Name="HeaderSettingsButton" Grid.Column="3" Click="HeaderSettingsButton_Click"
                            Width="26" Height="26" Padding="0" CornerRadius="13" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="#FF8FA9B5"/>
                    </Button>
                </Grid>

                <!-- Fila 1: Banner dinámico de reunión próxima o en curso con acceso rápido a videollamada -->
                <Border x:Name="UpcomingMeetingBanner"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="#FF283635"
                        BorderBrush="#FFFA991C"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="6,3"
                        Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE717;" FontSize="10.5" Foreground="#FFFA991C" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="UpcomingBannerTitle" Grid.Column="1" Text="Reunión en 5 min" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFBF3F2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button x:Name="UpcomingBannerJoinBtn" Grid.Column="2" Click="UpcomingBannerJoinBtn_Click" Height="19" Padding="6,0" CornerRadius="4" Background="#FFFA991C" Foreground="#FF032539" BorderThickness="0">
                            <Button.Resources>
                                <!-- Botón naranja: texto azul marino y se mantiene naranja al pasar el cursor o presionar -->
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFB04A"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFD9820F"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF032539"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF032539"/>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE717;" FontSize="9.5" FontWeight="Bold"/>
                                <TextBlock Text="Unirse" FontSize="9.5" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ================= VISTA 1: INICIO =================
                     Dos columnas separadas por una línea fina: a la izquierda la música
                     (carátula grande y controles bajo el título); a la derecha la próxima
                     reunión y accesos rápidos en píldoras. -->
                <Grid x:Name="MediaView" Grid.Row="2" Visibility="Visible" ColumnSpacing="14">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="214"/>
                    </Grid.ColumnDefinitions>

                    <!-- Columna izquierda: música -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="76" Height="76" CornerRadius="12" Background="#FF0A3249" VerticalAlignment="Top">
                                <Grid>
                                    <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
                                    <FontIcon x:Name="AlbumPlaceholder" Glyph="&#xE8D6;" FontSize="24"
                                              Foreground="#FF6F8E9C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="TrackTitle" Text="No hay reproducción activa"
                                           Foreground="#FFFBF3F2" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock x:Name="TrackArtist" Text="Pon música en Spotify o en tu navegador"
                                           Foreground="#FF8FA9B5" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="-4,6,0,0">
                                    <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Click="PreviousButton_Click"
                                            Background="Transparent" Foreground="#FFDCE3E5" FontSize="13"
                                            Width="30" Height="30" CornerRadius="15" Padding="0" BorderThickness="0"/>
                                    <Button x:Name="PlayPauseButton" Content="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                            Click="PlayPauseButton_Click" Width="32" Height="32" CornerRadius="16"
                                            Background="#FFFA991C" Foreground="#FF032539" FontSize="13" BorderThickness="0" Padding="0">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFB04A"/>
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFD9820F"/>
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF032539"/>
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF032539"/>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Click="NextButton_Click"
                                            Background="Transparent" Foreground="#FFDCE3E5" FontSize="13"
                                            Width="30" Height="30" CornerRadius="15" Padding="0" BorderThickness="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Barra de progreso interactiva -->
                        <Grid x:Name="ProgressTrack" Grid.Row="1" ColumnSpacing="8" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" Text="00:00" Foreground="#FF6F8E9C" FontSize="10" VerticalAlignment="Center"/>
                            <Grid x:Name="ProgressBarTrack" Grid.Column="1" Height="14" VerticalAlignment="Center"
                                  Background="Transparent" SizeChanged="ProgressBarTrack_SizeChanged" Tapped="ProgressBarTrack_Tapped">
                                <Border Height="3" Background="#FF114059" CornerRadius="1.5" VerticalAlignment="Center"/>
                                <Border x:Name="ProgressFill" Height="3" Background="#FFFBF3F2"
                                        CornerRadius="1.5" HorizontalAlignment="Left" Width="0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="RemainingText" Grid.Column="2" Text="--:--" Foreground="#FF6F8E9C" FontSize="10" VerticalAlignment="Center"/>
                        </Grid>

                    </Grid>

                    <!-- Separador -->
                    <Rectangle Grid.Column="1" Width="1" Fill="#1FFBF3F2" Margin="0,4"/>

                    <!-- Columna derecha: la letra de la canción mientras suena; si una reunión
                         está por empezar o en curso, la reunión tiene prioridad. -->
                    <Grid Grid.Column="2">
                        <StackPanel x:Name="HomeInfoPanel" Spacing="6" VerticalAlignment="Top">
                            <StackPanel Spacing="1" Margin="2,0,0,2">
                                <TextBlock x:Name="HomeMeetingTitle" Text="No tienes más reuniones hoy" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FFFBF3F2" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock x:Name="HomeMeetingWhen" Text="Agenda libre" FontSize="10.5" Foreground="#FF8FA9B5"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            </StackPanel>
                            <Button x:Name="HomeJoinButton" Click="HomeJoinButton_Click" Visibility="Collapsed"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="32" CornerRadius="16"
                                    Padding="14,0" Background="#FF0A3249" Foreground="#FFFBF3F2" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE714;" FontSize="12"/>
                                    <TextBlock Text="Unirse a la reunión" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="HomeCopyInfoButton" Click="HomeCopyInfoButton_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="32" CornerRadius="16"
                                    Padding="14,0" Background="#FF0A3249" Foreground="#FFFBF3F2" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="#FFFA991C"/>
                                    <TextBlock x:Name="HomeCopyInfoLabel" Text="Copiar datos del equipo" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Letras sincronizadas (LRCLIB): línea actual y siguiente. Clic para saltar a esa línea. -->
                        <StackPanel x:Name="LyricsPanel" Visibility="Collapsed" Spacing="6" VerticalAlignment="Center" Margin="2,0,0,0">
                            <TextBlock x:Name="LyricsCurrentLine" Text=" " FontSize="14" FontWeight="SemiBold" Foreground="#FFFBF3F2"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3" LineHeight="18"
                                       Tapped="LyricsLine_Tapped"/>
                            <TextBlock x:Name="LyricsNextLine" Text=" " FontSize="11.5" Foreground="#FF6F8E9C"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                                       Tapped="LyricsLine_Tapped"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= VISTA 2: DEV BACKLOG / TO-DO ================= -->
                <Grid x:Name="BacklogView" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Entrada rápida de backlog con tag dinámico y botón de adición -->
                    <Grid Grid.Row="0" Margin="0,1,0,6" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Chip de etiqueta ciclable (TODO -> FEAT -> FIX -> REFACTOR -> DOCS) -->
                        <Button x:Name="TagCycleButton"
                                Click="TagCycleButton_Click"
                                Height="26"
                                Padding="6,0"
                                CornerRadius="5"
                                Background="#FF0A3249"
                                BorderThickness="1"
                                BorderBrush="#FF1F5670"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentTagLabel" Text="TODO" FontSize="10.5" FontWeight="Bold" Foreground="#FF45C4B0"/>
                        </Button>

                        <!-- Entrada de texto de la tarea -->
                        <!-- El borde lo dibuja el contenedor: el del TextBox se recortaba por el alto mínimo del tema -->
                        <Border x:Name="NewTaskInputBorder"
                                Grid.Column="1"
                                Height="26"
                                Background="#FF0A3249"
                                BorderBrush="#FF1F5670"
                                BorderThickness="1"
                                CornerRadius="5">
                            <TextBox x:Name="NewTaskInput"
                                     MinHeight="0"
                                     FontSize="11"
                                     PlaceholderText="Nueva tarea (ej: fix: error al iniciar sesión)" PlaceholderForeground="#FF8FA9B5"
                                     Background="Transparent"
                                     Foreground="#FFFBF3F2"
                                     BorderThickness="0"
                                     Padding="7,1"
                                     VerticalContentAlignment="Center"
                                     GotFocus="NewTaskInput_GotFocus"
                                     LostFocus="NewTaskInput_LostFocus"
                                     KeyDown="NewTaskInput_KeyDown">
                                <!-- Oscuro también al escribir: el tema por defecto lo vuelve blanco al enfocarlo -->
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFBF3F2"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                        </Border>

                        <!-- Botón añadir tarea -->
                        <Button x:Name="AddTaskButton"
                                Grid.Column="2"
                                Click="AddTaskButton_Click"
                                Height="26"
                                Width="26"
                                Padding="0"
                                CornerRadius="5"
                                Background="#FFFA991C"
                                Foreground="#FF032539"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Button.Resources>
                                <!-- Botón naranja: texto azul marino y se mantiene naranja al pasar el cursor o presionar -->
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFB04A"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFD9820F"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF032539"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF032539"/>
                            </Button.Resources>
                            <FontIcon Glyph="&#xE710;" FontSize="11" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <!-- Lista con scroll sutil: ocupa lo que sobra, así la barra inferior nunca se corta -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TasksItemsPanel" Spacing="3"/>
                    </ScrollViewer>

                    <!-- Barra inferior de estado del backlog: conteo y acciones rápidas -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="BacklogSummaryText"
                                   Text="0 pendientes"
                                   FontSize="10"
                                   Foreground="#FF8FA9B5"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Copiar en formato Markdown para PRs y commits -->
                            <Button x:Name="CopyMarkdownButton"
                                    Click="CopyMarkdownButton_Click"
                                    Height="21"
                                    Padding="6,0"
                                    CornerRadius="4"
                                    Background="#FF114059"
                                    BorderThickness="1"
                                    BorderBrush="#FF1F5670">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="9.5" Foreground="#FFB8CBD3"/>
                                    <TextBlock x:Name="CopyMarkdownLabel" Text="Copiar MD" FontSize="10" Foreground="#FFB8CBD3" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <!-- Limpiar tareas completadas -->
                            <Button x:Name="ClearCompletedButton"
                                    Click="ClearCompletedButton_Click"
                                    Height="21"
                                    Padding="6,0"
                                    CornerRadius="4"
                                    Background="#FF114059"
                                    BorderThickness="1"
                                    BorderBrush="#FF1F5670">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="9.5" Foreground="#FFFF7F78"/>
                                    <TextBlock Text="Limpiar" FontSize="10" Foreground="#FFFF7F78" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= VISTA 3: CALENDARIO Y AGENDA DEV ================= -->
                <Grid x:Name="CalendarView" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Fila 0: Barra superior de submodos [ Agenda | Semana | Mes ] + Navegación + [ + Evento ] + [ 🔄 Sync ] -->
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selector de submódo del calendario -->
                        <Border Background="#1AFBF3F2" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="1">
                                <Button x:Name="CalSubAgendaBtn" Click="CalSubAgendaBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="#FF1C768F" BorderThickness="0">
                                    <TextBlock x:Name="CalSubAgendaLabel" Text="Agenda" FontSize="9.5" Foreground="#FFFBF3F2" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="CalSubWeekBtn" Click="CalSubWeekBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="Transparent" BorderThickness="0">
                                    <TextBlock x:Name="CalSubWeekLabel" Text="Semana" FontSize="9.5" Foreground="#FFB8CBD3"/>
                                </Button>
                                <Button x:Name="CalSubMonthBtn" Click="CalSubMonthBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="Transparent" BorderThickness="0">
                                    <TextBlock x:Name="CalSubMonthLabel" Text="Mes" FontSize="9.5" Foreground="#FFB8CBD3"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Navegación de fecha activa (< Día/Mes >) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="CalPrevDateBtn" Click="CalPrevDateBtn_Click" Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE76B;" FontSize="8.5" Foreground="#FFB8CBD3"/>
                            </Button>
                            <TextBlock x:Name="CalCurrentTitleLabel" Text="Hoy" FontSize="10" FontWeight="SemiBold" Foreground="#FFFBF3F2" VerticalAlignment="Center"/>
                            <Button x:Name="CalNextDateBtn" Click="CalNextDateBtn_Click" Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE76C;" FontSize="8.5" Foreground="#FFB8CBD3"/>
                            </Button>
                        </StackPanel>

                        <!-- Botones de Acción: Nuevo Evento y Sincronización -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <Button x:Name="CalNewEventBtn" Click="CalNewEventBtn_Click" Height="21" Padding="6,0" CornerRadius="5" Background="#FFFA991C" Foreground="#FF032539" BorderThickness="0">
                                <Button.Resources>
                                    <!-- Botón naranja: texto azul marino y se mantiene naranja al pasar el cursor o presionar -->
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFB04A"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFD9820F"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF032539"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF032539"/>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE710;" FontSize="9.5" FontWeight="Bold"/>
                                    <TextBlock Text="Evento" FontSize="9.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CalSyncBtn" Click="CalSyncBtn_Click" Height="21" Width="21" Padding="0" CornerRadius="5" Background="#FF114059" BorderThickness="1" BorderBrush="#FF1F5670">
                                <FontIcon Glyph="&#xE895;" FontSize="10" Foreground="#FFB8CBD3"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Fila 1: Área de contenido dinámico (Agenda, Semana o Mes) o Formularios Overlay -->
                    <Grid Grid.Row="1">
                        <!-- Panel 1: Agenda Diaria -->
                        <Grid x:Name="CalAgendaContainer" Visibility="Visible">
                            <ScrollViewer x:Name="AgendaScrollViewer" Height="136" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="AgendaEventsList" Spacing="4"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Panel 2: Tira Semanal + Agenda del día de la semana -->
                        <Grid x:Name="CalWeekContainer" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tira de 7 días de la semana -->
                            <Grid x:Name="WeekStripGrid" Grid.Row="0" Margin="0,0,0,4"/>
                            <!-- Lista de eventos del día seleccionado de la semana -->
                            <ScrollViewer Grid.Row="1" Height="102" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="WeekEventsList" Spacing="3"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Panel 3: Vista Mensual (Matriz de días) -->
                        <Grid x:Name="CalMonthContainer" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Encabezados de días (D L M M J V S) -->
                            <Grid x:Name="MonthDayHeadersGrid" Grid.Row="0" Margin="0,0,0,2"/>
                            <!-- Cuadrícula interactiva de 7 columnas x 5-6 filas -->
                            <Grid x:Name="MonthDaysGrid" Grid.Row="1" Height="120"/>
                        </Grid>

                        <!-- Panel 4: Formulario de Creación / Edición de Evento (Overlay) -->
                        <Grid x:Name="CalEventFormOverlay" Visibility="Collapsed" Background="#FF0A3249" CornerRadius="6" Padding="7,5">
                            <Grid.RenderTransform>
                                <TranslateTransform/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Título y categoría -->
                            <Grid Grid.Row="0" ColumnSpacing="5" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FormEventTitle" PlaceholderText="Título del evento o reunión..." PlaceholderForeground="#FF8FA9B5" Height="24" FontSize="10" Background="#FF0A3249" Foreground="#FFFBF3F2" BorderBrush="#FF1F5670" CornerRadius="4" Padding="5,1"/>
                                <Button x:Name="FormCategoryBtn" Grid.Column="1" Click="FormCategoryBtn_Click" Height="24" Padding="5,0" CornerRadius="4" Background="#FF114059" BorderThickness="1" BorderBrush="#FF1F5670">
                                    <TextBlock x:Name="FormCategoryLabel" Text="MEETING" FontSize="9" FontWeight="Bold" Foreground="#FF5DB3CC"/>
                                </Button>
                            </Grid>

                            <!-- Fecha, Hora Inicio, Hora Fin -->
                            <Grid Grid.Row="1" ColumnSpacing="5" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FormEventDate" PlaceholderText="YYYY-MM-DD" PlaceholderForeground="#FF8FA9B5" Height="23" FontSize="10.5" Background="#FF0A3249" Foreground="#FFFBF3F2" BorderBrush="#FF1F5670" CornerRadius="4" Padding="5,1"/>
                                <TextBox x:Name="FormStartTime" Grid.Column="1" Width="50" PlaceholderText="10:00" PlaceholderForeground="#FF8FA9B5" Height="23" FontSize="10.5" Background="#FF0A3249" Foreground="#FFFBF3F2" BorderBrush="#FF1F5670" CornerRadius="4" Padding="4,1" TextChanged="FormTime_TextChanged"/>
                                <TextBox x:Name="FormEndTime" Grid.Column="2" Width="50" PlaceholderText="10:30" PlaceholderForeground="#FF8FA9B5" Height="23" FontSize="10.5" Background="#FF0A3249" Foreground="#FFFBF3F2" BorderBrush="#FF1F5670" CornerRadius="4" Padding="4,1" TextChanged="FormTime_TextChanged"/>
                            </Grid>

                            <!-- Enlace videollamada + Vincular con Backlog -->
                            <Grid Grid.Row="2" ColumnSpacing="5" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FormMeetingUrl" PlaceholderText="Link Meet / Teams / Zoom..." PlaceholderForeground="#FF8FA9B5" Height="23" FontSize="10.5" Background="#FF0A3249" Foreground="#FFFBF3F2" BorderBrush="#FF1F5670" CornerRadius="4" Padding="5,1"/>
                                <ComboBox x:Name="FormTaskLinkCombo" Grid.Column="1" PlaceholderText="Vincular con una tarea" Height="30" MinHeight="0" Padding="10,0,0,0" VerticalContentAlignment="Center" FontSize="10.5" Background="#FF0A3249" BorderBrush="#FF1F5670" CornerRadius="4" HorizontalAlignment="Stretch"/>
                            </Grid>

                            <!-- Advertencia de Conflicto en vivo + Botones Guardar / Cancelar -->
                            <Grid Grid.Row="3" Margin="0,1,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FormConflictWarning" Text="" FontSize="9.5" Foreground="#FFFFC25C" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button x:Name="FormCancelBtn" Click="FormCancelBtn_Click" Height="21" Padding="7,0" CornerRadius="4" Background="#FF114059" Foreground="#FFB8CBD3" FontSize="10" BorderThickness="0">
                                        <TextBlock Text="Cancelar"/>
                                    </Button>
                                    <Button x:Name="FormSaveBtn" Click="FormSaveBtn_Click" Height="21" Padding="7,0" CornerRadius="4" Background="#FFFA991C" Foreground="#FF032539" FontSize="10" FontWeight="Bold" BorderThickness="0">
                                        <Button.Resources>
                                            <!-- Botón naranja: texto azul marino y se mantiene naranja al pasar el cursor o presionar -->
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFB04A"/>
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFD9820F"/>
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF032539"/>
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF032539"/>
                                        </Button.Resources>
                                        <TextBlock Text="Guardar"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Panel 5: Diálogo de Sincronización e Importación (Google / Outlook / iCal) -->
                        <Grid x:Name="CalSyncOverlay" Visibility="Collapsed" Background="#FF0A3249" CornerRadius="6" Padding="8,6">
                            <Grid.RenderTransform>
                                <TranslateTransform/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Fila 0: Encabezado (Título + Botón Cerrar) -->
                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="10" Foreground="#FFFA991C"/>
                                    <TextBlock Text="Sincronización de Calendario" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFBF3F2"/>
                                </StackPanel>
                                <Button x:Name="CloseSyncBtn" Grid.Column="1" Click="CloseSyncBtn_Click" Height="19" Width="19" Padding="0" CornerRadius="3" Background="#FF114059" BorderThickness="0">
                                    <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="#FFB8CBD3"/>
                                </Button>
                            </Grid>

                            <!-- Fila 1: Subtítulo (bien separado, sin sobreponerse) -->
                            <TextBlock Grid.Row="1" Text="Trae tus reuniones de Outlook a la isla (solo lectura: no se cambia nada en Outlook) o importa un .ics:" FontSize="9" Foreground="#FFB8CBD3" TextWrapping="Wrap" Margin="0,0,0,5"/>

                            <!-- Fila 2: Acciones de IMPORTACIÓN de reuniones -->
                            <Grid Grid.Row="2" ColumnSpacing="5" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ImportIcsFileBtn" Click="ImportIcsFileBtn_Click" Height="24" HorizontalAlignment="Stretch" CornerRadius="4" Background="#FF0F4259" BorderThickness="1" BorderBrush="#FF1C5F78">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="9.5" Foreground="#FF5DB3CC"/>
                                        <TextBlock x:Name="ImportFileLabel" Text="Cargar archivo .ics" FontSize="9.5" Foreground="#FFFBF3F2" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ImportClipboardBtn" Grid.Column="1" Click="ImportClipboardBtn_Click" Height="24" HorizontalAlignment="Stretch" CornerRadius="4" Background="#FF0D3D45" BorderThickness="1" BorderBrush="#FF14574F">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE77F;" FontSize="9.5" Foreground="#FFFA991C"/>
                                        <TextBlock x:Name="ImportClipboardLabel" Text="Pegar de Portapapeles" FontSize="9.5" Foreground="#FFFBF3F2" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Fila 3: Importar de Outlook (solo lectura) y copiar .ics para Google -->
                            <Grid Grid.Row="3" ColumnSpacing="5" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="OutlookImportBtn" Click="OutlookImportBtn_Click" Height="24" HorizontalAlignment="Stretch" CornerRadius="4" Background="#FF0F4259" BorderThickness="1" BorderBrush="#FF1C5F78">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE896;" FontSize="9.5" Foreground="#FF5DB3CC"/>
                                        <TextBlock x:Name="OutlookImportLabel" Text="Importar de Outlook" FontSize="9.5" Foreground="#FFFBF3F2" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CopyIcsBtn" Grid.Column="1" Click="CopyIcsBtn_Click" Height="24" HorizontalAlignment="Stretch" CornerRadius="4" Background="#FF114059" BorderThickness="1" BorderBrush="#FF1F5670">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="9.5" Foreground="#FFFA991C"/>
                                        <TextBlock x:Name="CopyIcsLabel" Text="Copiar .ics (Google)" FontSize="9.5" Foreground="#FFFBF3F2"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Fila 4: Mensaje dinámico de Estado / Feedback -->
                            <TextBlock x:Name="SyncStatusMsg" Grid.Row="4" Text="" FontSize="9" Foreground="#FF4FD1A5" FontWeight="SemiBold" TextAlignment="Center" Margin="0,3,0,0" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ================= VISTA 4: TEMPORIZADOR POMODORO / DEEP WORK ================= -->
                <Grid x:Name="PomodoroView" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Fila 0: Selector de Modo [ 🎯 Trabajo (25m) | ☕ Pausa (5m) | 🌴 Largo (15m) ] + Conteo -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#1AFBF3F2" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="1">
                                <Button x:Name="PomoModeWorkBtn" Click="PomoModeWorkBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="#FF1C768F" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="9"/>
                                        <TextBlock x:Name="PomoModeWorkLabel" Text="Trabajo (25m)" FontSize="9.5" Foreground="#FFFBF3F2" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PomoModeShortBtn" Click="PomoModeShortBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="☕" FontSize="9"/>
                                        <TextBlock x:Name="PomoModeShortLabel" Text="Pausa (5m)" FontSize="9.5" Foreground="#FFB8CBD3"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PomoModeLongBtn" Click="PomoModeLongBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="🌴" FontSize="9"/>
                                        <TextBlock x:Name="PomoModeLongLabel" Text="Largo (15m)" FontSize="9.5" Foreground="#FFB8CBD3"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Contador de pomodoros completados hoy -->
                        <Border Grid.Column="1" Background="#20FA991C" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="🍅" FontSize="9.5"/>
                                <TextBlock x:Name="PomodoroCompletedCountLabel" Text="0 hoy" FontSize="9.5" FontWeight="Bold" Foreground="#FFFA991C"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Fila 1: Display del Temporizador Central + Barra de Progreso + Vínculo a Backlog -->
                    <Grid Grid.Row="1" Margin="0,2,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tiempo en formato grande y elegante con estado -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,2">
                            <TextBlock x:Name="PomodoroTimerDisplay" Text="25:00" FontSize="30" FontWeight="Bold" Foreground="#FFFBF3F2" HorizontalAlignment="Center" Margin="0,-4,0,-4"/>
                            <TextBlock x:Name="PomodoroStateSubtitle" Text="Sesión de Concentración" FontSize="10" Foreground="#FFB8CBD3" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Barra de progreso sutil del intervalo -->
                        <Grid x:Name="PomodoroTrackGrid" Grid.Row="1" Height="4" Margin="24,2,24,4" SizeChanged="PomodoroTrackGrid_SizeChanged">
                            <Border Background="#FF114059" CornerRadius="2"/>
                            <Border x:Name="PomodoroProgressBar" Background="#FFFA991C" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                        </Grid>

                        <!-- Vínculo a tarea de Backlog -->
                        <Grid Grid.Row="2" ColumnSpacing="6" Margin="14,1,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎯 Tarea:" FontSize="9.5" Foreground="#FFB8CBD3" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PomoTaskLinkCombo" Grid.Column="1" Height="30" MinHeight="0" Padding="10,0,0,0" VerticalContentAlignment="Center" FontSize="10.5" PlaceholderText="Elegir una tarea" Background="#FF0A3249" BorderBrush="#FF1F5670" CornerRadius="4" HorizontalAlignment="Stretch" SelectionChanged="PomoTaskLinkCombo_SelectionChanged"/>
                        </Grid>
                    </Grid>

                    <!-- Fila 2: Botones de Control (Play/Pause, Reset, Skip) -->
                    <Grid Grid.Row="2" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botón Reiniciar -->
                        <Button x:Name="PomoResetBtn" Grid.Column="0" Click="PomoResetBtn_Click" Height="23" Padding="8,0" CornerRadius="5" Background="#FF114059" BorderThickness="1" BorderBrush="#FF1F5670" HorizontalAlignment="Right" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72C;" FontSize="9" Foreground="#FFB8CBD3"/>
                                <TextBlock Text="Reiniciar" FontSize="9.5" Foreground="#FFB8CBD3"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón Principal Play / Pause -->
                        <Button x:Name="PomoPlayPauseBtn" Grid.Column="1" Click="PomoPlayPauseBtn_Click" Width="34" Height="34" CornerRadius="17" Background="#FFFA991C" Foreground="#FF032539" BorderThickness="0" HorizontalAlignment="Center">
                            <FontIcon x:Name="PomoPlayPauseIcon" Glyph="&#xE768;" FontSize="12" FontWeight="Bold"/>
                        </Button>

                        <!-- Botón Saltar Intervalo -->
                        <Button x:Name="PomoSkipBtn" Grid.Column="2" Click="PomoSkipBtn_Click" Height="23" Padding="8,0" CornerRadius="5" Background="#FF114059" BorderThickness="1" BorderBrush="#FF1F5670" HorizontalAlignment="Left" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Saltar" FontSize="9.5" Foreground="#FFB8CBD3"/>
                                <FontIcon Glyph="&#xE893;" FontSize="9" Foreground="#FFB8CBD3"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ================= VISTA 5: SISTEMA Y RED (IT) ================= -->
                <Grid x:Name="SystemView" Grid.Row="2" Visibility="Collapsed" RowSpacing="6">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Fila 0: CPU, memoria, disco y tiempo encendido -->
                    <Grid ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FF0A3249" CornerRadius="6" Padding="7,5">
                            <StackPanel Spacing="2">
                                <TextBlock Text="CPU" FontSize="9" Foreground="#FF8FA9B5" FontWeight="Medium"/>
                                <TextBlock x:Name="SysCpuValue" Text="--" FontSize="13" FontWeight="SemiBold" Foreground="#FFFBF3F2"/>
                                <TextBlock x:Name="SysCpuDetail" Text=" " FontSize="8.5" Foreground="#FF8FA9B5" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <Grid x:Name="SysCpuTrack" Height="3" Background="#FF114059" CornerRadius="1.5" Margin="0,2,0,0">
                                    <Border x:Name="SysCpuBar" Background="#FF5DB3CC" CornerRadius="1.5" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#FF0A3249" CornerRadius="6" Padding="7,5">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Memoria" FontSize="9" Foreground="#FF8FA9B5" FontWeight="Medium"/>
                                <TextBlock x:Name="SysRamValue" Text="--" FontSize="13" FontWeight="SemiBold" Foreground="#FFFBF3F2"/>
                                <TextBlock x:Name="SysRamDetail" Text=" " FontSize="8.5" Foreground="#FF8FA9B5" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <Grid x:Name="SysRamTrack" Height="3" Background="#FF114059" CornerRadius="1.5" Margin="0,2,0,0">
                                    <Border x:Name="SysRamBar" Background="#FFC48FD6" CornerRadius="1.5" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FF0A3249" CornerRadius="6" Padding="7,5">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Disco" FontSize="9" Foreground="#FF8FA9B5" FontWeight="Medium"/>
                                <TextBlock x:Name="SysDiskValue" Text="--" FontSize="13" FontWeight="SemiBold" Foreground="#FFFBF3F2"/>
                                <TextBlock x:Name="SysDiskDetail" Text=" " FontSize="8.5" Foreground="#FF8FA9B5" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <Grid x:Name="SysDiskTrack" Height="3" Background="#FF114059" CornerRadius="1.5" Margin="0,2,0,0">
                                    <Border x:Name="SysDiskBar" Background="#FFFFC25C" CornerRadius="1.5" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#FF0A3249" CornerRadius="6" Padding="7,5">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Encendido" FontSize="9" Foreground="#FF8FA9B5" FontWeight="Medium"/>
                                <TextBlock x:Name="SysUptimeValue" Text="--" FontSize="13" FontWeight="SemiBold" Foreground="#FFFBF3F2"/>
                                <TextBlock x:Name="SysUptimeDetail" Text=" " FontSize="8.5" Foreground="#FF8FA9B5" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <Grid x:Name="SysUptimeTrack" Height="3" Background="#FF114059" CornerRadius="1.5" Margin="0,2,0,0">
                                    <Border x:Name="SysUptimeBar" Background="#FFFA991C" CornerRadius="1.5" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Fila 1: Conexión principal, IP, VPN y latencia -->
                    <Border Grid.Row="1" Background="#FF0A3249" CornerRadius="6" Padding="8,6">
                        <Grid ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon x:Name="SysNetIcon" Glyph="&#xE701;" FontSize="13" Foreground="#FF4FD1A5" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SysNetTitle" Text="Comprobando red..." FontSize="10" FontWeight="SemiBold" Foreground="#FFFBF3F2" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock x:Name="SysNetDetail" Text=" " FontSize="9.5" Foreground="#FF8FA9B5" TextTrimming="CharacterEllipsis" MaxLines="1" IsTextSelectionEnabled="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border x:Name="SysVpnPill" Visibility="Collapsed" Background="#FF0F4259" CornerRadius="5" Padding="5,1" ToolTipService.ToolTip="VPN activa">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xE705;" FontSize="9" Foreground="#FF5DB3CC"/>
                                        <TextBlock Text="VPN" FontSize="9" FontWeight="Bold" Foreground="#FF5DB3CC"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="SysLatencyPill" Background="#FF114059" CornerRadius="5" Padding="5,1" ToolTipService.ToolTip="Latencia (ping)">
                                    <TextBlock x:Name="SysLatencyText" Text="-- ms" FontSize="9" FontWeight="Bold" Foreground="#FFB8CBD3"/>
                                </Border>
                                <Button x:Name="SysCopyInfoBtn" Click="SysCopyInfoBtn_Click" Height="20" Padding="5,0" CornerRadius="4" Background="#FF114059" BorderThickness="1" BorderBrush="#FF1F5670" ToolTipService.ToolTip="Copiar datos del equipo para un ticket">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="9" Foreground="#FFB8CBD3"/>
                                        <TextBlock x:Name="SysCopyInfoLabel" Text="Copiar" FontSize="9.5" Foreground="#FFB8CBD3"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= VISTA: PLANNER SEMANAL ================= -->
                <Grid x:Name="PlannerView" Grid.Row="2" Visibility="Collapsed" RowSpacing="6" RequestedTheme="Dark">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Semana visible y navegación -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Click="PlannerPrevWeek_Click" Width="24" Height="24" Padding="0" CornerRadius="12" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE76B;" FontSize="10" Foreground="#FFB8CBD3"/>
                        </Button>
                        <TextBlock x:Name="PlannerWeekLabel" FontSize="12" FontWeight="SemiBold" Foreground="#FFFBF3F2" VerticalAlignment="Center"/>
                        <Button Click="PlannerNextWeek_Click" Width="24" Height="24" Padding="0" CornerRadius="12" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#FFB8CBD3"/>
                        </Button>
                        <Button x:Name="PlannerTodayButton" Click="PlannerToday_Click" Visibility="Collapsed" Height="24" Padding="10,0" Margin="4,0,0,0"
                                CornerRadius="12" Background="#FF0A3249" Foreground="#FFFBF3F2" BorderThickness="0">
                            <TextBlock Text="Volver a esta semana" FontSize="10.5" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>

                    <!-- Horario de lunes a viernes y "Recuerda" (filas y bloques se crean en código) -->
                    <Grid x:Name="PlannerGrid" Grid.Row="1" Background="Transparent"
                          PointerReleased="PlannerGrid_PointerReleased" PointerExited="PlannerGrid_PointerExited"/>
                </Grid>

                <!-- ================= VISTA 6: SHELF DE ARCHIVOS Y TEXTOS ================= -->
                <Grid x:Name="ShelfView" Grid.Row="2" Visibility="Collapsed" RowSpacing="5">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ShelfSummary" Text="Arrastra archivos o texto a la isla" FontSize="10" Foreground="#FF8FA9B5"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <Button x:Name="ShelfPasteBtn" Grid.Column="1" Click="ShelfPasteBtn_Click" Height="20" Padding="6,0" CornerRadius="4"
                                Background="#FF114059" BorderThickness="1" BorderBrush="#FF1F5670" ToolTipService.ToolTip="Agregar lo copiado (archivos o texto)">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE77F;" FontSize="9" Foreground="#FFB8CBD3"/>
                                <TextBlock Text="Pegar" FontSize="9.5" Foreground="#FFB8CBD3"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ShelfClearBtn" Grid.Column="2" Click="ShelfClearBtn_Click" Height="20" Padding="6,0" CornerRadius="4"
                                Background="#FF114059" BorderThickness="1" BorderBrush="#FF1F5670" ToolTipService.ToolTip="Quitar los seleccionados (o todos si no hay selección)">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE74D;" FontSize="9" Foreground="#FFB8CBD3"/>
                                <TextBlock x:Name="ShelfClearLabel" Text="Limpiar" FontSize="9.5" Foreground="#FFB8CBD3"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <GridView x:Name="ShelfGrid"
                                  SelectionMode="Extended"
                                  CanDragItems="True"
                                  DragItemsStarting="ShelfGrid_DragItemsStarting"
                                  SelectionChanged="ShelfGrid_SelectionChanged"
                                  Padding="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="ShelfEmptyHint" Text="Suelta aquí archivos, carpetas o texto.&#x0a;Solo se guarda su ubicación, no una copia."
                                   FontSize="10.5" Foreground="#FF6F8E9C" TextAlignment="Center" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
