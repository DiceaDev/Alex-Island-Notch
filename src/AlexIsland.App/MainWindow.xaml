<UserControl
    x:Class="AlexIsland.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fondo transparente: la ventana de la isla (IslandHostWindow) se compone
         con transparencia por píxel, así que alrededor del notch se ve el escritorio
         y sus curvas quedan suavizadas. -->
    <Grid x:Name="RootGrid">
        <!-- Escala elegida por el usuario en Ajustes; la ventana se ajusta al mismo factor. -->
        <Grid.RenderTransform>
            <ScaleTransform x:Name="NotchUserScale" ScaleX="1" ScaleY="1" CenterX="0" CenterY="0"/>
        </Grid.RenderTransform>
        <Grid x:Name="IslandContainer"
              Width="196"
              Height="36"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              AllowDrop="True"
              DragEnter="IslandContainer_DragEnter"
              DragOver="IslandContainer_DragOver"
              DragLeave="IslandContainer_DragLeave"
              Drop="IslandContainer_Drop"
              PointerEntered="IslandContainer_PointerEntered"
              PointerExited="IslandContainer_PointerExited"
              Tapped="IslandContainer_Tapped">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <!-- Sombra difuminada (DropShadow de composición con la silueta del notch como máscara) -->
            <Canvas x:Name="NotchShadowHost" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- Fondo negro absoluto con silueta exacta del Notch de Mac (con orejas cóncavas y esquinas redondeadas) -->
            <Path x:Name="NotchBackground"
                  Fill="#FF000000"
                  Stroke="#1FFFFFFF"
                  StrokeThickness="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"/>

            <!-- Modo 1: Resting. Mascota: los ojos rasgados del zorro de Alex Island,
                 en el naranja de la marca (#FF5A00).
                 Parpadean de vez en cuando y, tras un rato sin actividad, se cierran (duerme). -->
            <Grid x:Name="RestingContent" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32">
                <!-- Resplandor cálido detrás de los ojos, como en el logo -->
                <Ellipse x:Name="FoxEyesGlow" Width="46" Height="22" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66FF5A00" Offset="0"/>
                            <GradientStop Color="#26FF5A00" Offset="0.55"/>
                            <GradientStop Color="#00FF5A00" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Polygon x:Name="LeftEye" Points="0,0 4,1.2 10,8 5,6.4" Width="10" Height="8">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFB27A" Offset="0"/>
                                <GradientStop Color="#FFFF7A2E" Offset="0.5"/>
                                <GradientStop Color="#FFFF5A00" Offset="1"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.RenderTransform>
                            <ScaleTransform x:Name="LeftEyeScale" CenterX="5" CenterY="4"/>
                        </Polygon.RenderTransform>
                    </Polygon>
                    <Polygon x:Name="RightEye" Points="10,0 6,1.2 0,8 5,6.4" Width="10" Height="8">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFB27A" Offset="0"/>
                                <GradientStop Color="#FFFF7A2E" Offset="0.5"/>
                                <GradientStop Color="#FFFF5A00" Offset="1"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.RenderTransform>
                            <ScaleTransform x:Name="RightEyeScale" CenterX="5" CenterY="4"/>
                        </Polygon.RenderTransform>
                    </Polygon>
                </StackPanel>
            </Grid>

            <!-- Modo 2: Closed (Contenido compacto con anillo de progreso circular estilo Nusa) -->
            <Grid x:Name="CompactContent" Margin="14,0,14,0" Height="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Anillo de progreso circular en vivo estilo Nusa -->
                    <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="1,0,3,0">
                        <Ellipse Width="14" Height="14" Stroke="#26FFFFFF" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="CompactProgressArc" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None"
                              Stroke="#FFFF5A00" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse x:Name="CompactCenterDot" Width="4" Height="4" Fill="#FFFF5A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Badge de Pomodoro / Focus activo en modo compacto -->
                    <Border x:Name="CompactPomodoroBadge"
                            Visibility="Collapsed"
                            Background="#FF2A1B1D"
                            BorderBrush="#FFFF5A00"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="3,1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="CompactPomodoroIcon" Text="🍅" FontSize="7.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompactPomodoroText" Text="25:00" Foreground="#FFFF5A00" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Badge sutil de reunión próxima en modo compacto -->
                    <Border x:Name="CompactMeetingBadge"
                            Visibility="Collapsed"
                            Background="#FF2A1405"
                            BorderBrush="#FFFF5A00"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="3,1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE717;" FontSize="7.5" Foreground="#FFFF5A00"/>
                            <TextBlock x:Name="CompactMeetingText" Text="10:00" Foreground="#FFFF5A00" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Badge sutil de backlog pendiente en modo compacto -->
                    <Border x:Name="CompactTaskBadge"
                            Visibility="Collapsed"
                            Background="#FF232633"
                            CornerRadius="4"
                            Padding="3,1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="7.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompactTaskCount" Text="0" Foreground="#FFA0A5B2" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Centro Dinámico: Título en negrita blanca y subtítulo de estado o reloj -->
                <Grid x:Name="CompactCenterContainer"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      Tapped="CompactCenter_Tapped"
                      Padding="2,0"
                      ToolTipService.ToolTip="Clic para alternar entre hora e información de reproducción/enfoque">
                    
                    <!-- 1. Reloj digital elegante -->
                    <TextBlock x:Name="CompactClock"
                               Text="13:40"
                               Foreground="#FFF5F5F7"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <!-- 2. Información multimedia dinámica: Título en negrita blanca + Subtítulo de artista -->
                    <StackPanel x:Name="CompactMediaInfo"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="0.5"
                                MaxWidth="150"
                                Visibility="Visible">
                        <TextBlock x:Name="CompactTrackTitle"
                                   Text="No hay reproducción activa"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                        <TextBlock x:Name="CompactTrackArtist"
                                   Text="Windows Media Session"
                                   FontSize="8"
                                   Foreground="#FFA0A5B2"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                    </StackPanel>

                    <!-- 3. Información de Pomodoro / Enfoque -->
                    <StackPanel x:Name="CompactFocusInfo"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="0.5"
                                MaxWidth="150"
                                Visibility="Collapsed">
                        <TextBlock x:Name="CompactFocusTitle"
                                   Text="Enfoque Activo"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFF5A00"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                        <TextBlock x:Name="CompactFocusTime"
                                   Text="25:00"
                                   FontSize="8"
                                   Foreground="#FFA0A5B2"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxLines="1"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="WaveformPanel" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,2,0">
                    <Border x:Name="WaveBar1" Width="2" Height="5" Background="#FFFF5A00" CornerRadius="1"/>
                    <Border x:Name="WaveBar2" Width="2" Height="11" Background="#FFFF5A00" CornerRadius="1"/>
                    <Border x:Name="WaveBar3" Width="2" Height="14" Background="#FFFF5A00" CornerRadius="1"/>
                    <Border x:Name="WaveBar4" Width="2" Height="7" Background="#FFFF5A00" CornerRadius="1"/>
                </StackPanel>
            </Grid>

            <!-- Modo 3: Peek (Notificación emergente de Hardware / Auriculares / Batería estilo Nusa) -->
            <Grid x:Name="PeekContent" Visibility="Collapsed" Margin="16,0,16,0" Height="42" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Izquierda: Anillo de batería/estado con icono Bluetooth/Rayo -->
                <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse Width="22" Height="22" Fill="#1EFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="20" Height="20" Stroke="#28FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Path x:Name="PeekProgressArc" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None"
                          Stroke="#FF42A5F5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <FontIcon x:Name="PeekIcon" Glyph="&#xE702;" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Centro-Izquierda: Título y subtítulo con espaciado respirable -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1.5">
                    <TextBlock x:Name="PeekTitle" Text="AirBuds Pro" FontSize="11.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    <TextBlock x:Name="PeekSubtitle" Text="Connected · 70%" FontSize="9" Foreground="#FFA0A5B2" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                </StackPanel>

                <!-- Derecha: Icono de periférico con ondas concéntricas de sonido -->
                <Grid Grid.Column="2" Width="28" Height="28" VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- Halo difuminado con el color del aviso (se asigna en código) -->
                    <Ellipse x:Name="PeekGlow" Width="44" Height="44" Margin="-8" IsHitTestVisible="False"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse x:Name="PeekRippleOuter" Width="28" Height="28" Stroke="#2242A5F5" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                    <Ellipse x:Name="PeekRippleInner" Width="21" Height="21" Stroke="#4442A5F5" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                    <Ellipse Width="17" Height="17" Fill="#1E42A5F5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <FontIcon x:Name="PeekRightIcon" Glyph="&#xE7F6;" FontSize="9.5" Foreground="#FF42A5F5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Contenido expandido sutil, compacto y elegante estilo Dynamic Island de Mac -->
            <Grid x:Name="ExpandedContent" Visibility="Collapsed" Opacity="0" Margin="18,6,18,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Fila 0: Cabecera con fecha/hora y selector por pestañas [ Música | Backlog | Calendario | Focus ] -->
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#FFFF5A00"/>
                        <TextBlock x:Name="HeaderClock" Text="mar 3 nov · 09:14"
                                   Foreground="#FFA0A5B2" FontSize="10.5" FontWeight="Medium"/>
                        <!-- Botón de vista previa de Peek de Hardware (AirBuds Pro / Auriculares) -->
                        <Button x:Name="DemoPeekBtn" Click="DemoPeekBtn_Click" ToolTipService.ToolTip="Probar Peek AirBuds Pro"
                                Width="18" Height="18" Padding="0" Margin="4,0,0,0" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE7F6;" FontSize="8.5" Foreground="#FF42A5F5"/>
                        </Button>
                    </StackPanel>

                    <!-- Selector segmentado tipo pestaña estilo Dynamic Island -->
                    <Border Grid.Column="1" Background="#1FFFFFFF" CornerRadius="10" Padding="2" VerticalAlignment="Center"
                            PointerWheelChanged="TabBar_PointerWheelChanged">
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <!-- Pestaña Multimedia -->
                            <Button x:Name="TabMediaButton"
                                    Click="TabMediaButton_Click"
                                    CornerRadius="8"
                                    Padding="5,2"
                                    Height="21"
                                    Background="#FF2A2D37"
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE768;" FontSize="8.5" Foreground="White"/>
                                    <TextBlock x:Name="TabMediaLabel" Text="Música" FontSize="8.5" Foreground="White" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <!-- Pestaña Backlog -->
                            <Button x:Name="TabBacklogButton"
                                    Click="TabBacklogButton_Click"
                                    CornerRadius="8"
                                    Padding="5,2"
                                    Height="21"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE756;" FontSize="8.5" Foreground="#FFA0A5B2"/>
                                    <TextBlock x:Name="TabBacklogLabel" Visibility="Collapsed" Text="Backlog" FontSize="8.5" Foreground="#FFA0A5B2" FontWeight="Medium"/>
                                    <Border x:Name="HeaderBacklogBadge" Background="#FF3E4251" CornerRadius="5" Padding="3,0" Margin="1,0,0,0">
                                        <TextBlock x:Name="HeaderBacklogCount" Text="0" FontSize="7.5" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Pestaña Calendario -->
                            <Button x:Name="TabCalendarButton"
                                    Click="TabCalendarButton_Click"
                                    CornerRadius="8"
                                    Padding="5,2"
                                    Height="21"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="8.5" Foreground="#FFA0A5B2"/>
                                    <TextBlock x:Name="TabCalendarLabel" Visibility="Collapsed" Text="Agenda" FontSize="8.5" Foreground="#FFA0A5B2" FontWeight="Medium"/>
                                    <Border x:Name="HeaderCalendarBadge" Background="#FF3E4251" CornerRadius="5" Padding="3,0" Margin="1,0,0,0">
                                        <TextBlock x:Name="HeaderCalendarCount" Text="0" FontSize="7.5" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Pestaña Focus / Pomodoro -->
                            <Button x:Name="TabPomodoroButton"
                                    Click="TabPomodoroButton_Click"
                                    CornerRadius="8"
                                    Padding="5,2"
                                    Height="21"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="🍅" FontSize="8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TabPomodoroLabel" Visibility="Collapsed" Text="Focus" FontSize="8.5" Foreground="#FFA0A5B2" FontWeight="Medium"/>
                                    <Border x:Name="HeaderPomodoroBadge" Background="#FF3E4251" CornerRadius="5" Padding="3,0" Margin="1,0,0,0">
                                        <TextBlock x:Name="HeaderPomodoroCount" Text="0" FontSize="7.5" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Pestaña Sistema (IT): equipo y red -->
                            <Button x:Name="TabSystemButton"
                                    Click="TabSystemButton_Click"
                                    CornerRadius="8"
                                    Padding="5,2"
                                    Height="21"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Sistema y red">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <FontIcon x:Name="TabSystemIcon" Glyph="&#xE9D9;" FontSize="8.5" Foreground="#FFA0A5B2"/>
                                    <TextBlock x:Name="TabSystemLabel" Visibility="Collapsed" Text="Sistema" FontSize="8.5" Foreground="#FFA0A5B2" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <!-- Pestaña Shelf: archivos y textos a mano -->
                            <Button x:Name="TabShelfButton"
                                    Click="TabShelfButton_Click"
                                    CornerRadius="8"
                                    Padding="5,2"
                                    Height="21"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Shelf: arrastra archivos o texto">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7B8;" FontSize="8.5" Foreground="#FFA0A5B2"/>
                                    <TextBlock x:Name="TabShelfLabel" Visibility="Collapsed" Text="Shelf" FontSize="8.5" Foreground="#FFA0A5B2" FontWeight="Medium"/>
                                    <Border x:Name="HeaderShelfBadge" Visibility="Collapsed" Background="#FF3E4251" CornerRadius="5" Padding="3,0" Margin="1,0,0,0">
                                        <TextBlock x:Name="HeaderShelfCount" Text="0" FontSize="7.5" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Fila 1: Banner dinámico de reunión próxima o en curso con acceso rápido a videollamada -->
                <Border x:Name="UpcomingMeetingBanner"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="#FF2A1405"
                        BorderBrush="#FFFF5A00"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="6,3"
                        Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE717;" FontSize="9.5" Foreground="#FFFF5A00" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="UpcomingBannerTitle" Grid.Column="1" Text="Reunión en 5 min" FontSize="9.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button x:Name="UpcomingBannerJoinBtn" Grid.Column="2" Click="UpcomingBannerJoinBtn_Click" Height="19" Padding="6,0" CornerRadius="4" Background="#FFFF5A00" Foreground="#FF0A0B0E" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE717;" FontSize="8.5" FontWeight="Bold"/>
                                <TextBlock Text="Unirse" FontSize="8.5" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ================= VISTA 1: REPRODUCTOR MULTIMEDIA ================= -->
                <Grid x:Name="MediaView" Grid.Row="2" Visibility="Visible">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Pista, Carátula y Controles -->
                    <Grid Grid.Row="0" Margin="0,2,0,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Carátula compacta -->
                        <Border Width="44" Height="44" CornerRadius="7" Background="#FF222329"
                                VerticalAlignment="Center">
                            <Grid>
                                <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
                                <FontIcon x:Name="AlbumPlaceholder" Glyph="&#xE768;" FontSize="18"
                                          Foreground="#FF8E929C" HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Información de pista -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TrackTitle" Text="No hay reproducción activa"
                                       Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            <TextBlock x:Name="TrackArtist" Text="Inicia música en Spotify o navegador"
                                       Foreground="#FFA4A7B0" FontSize="11"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </StackPanel>

                        <!-- Botones de control compactos -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets"
                                    Click="PreviousButton_Click"
                                    Background="Transparent" Foreground="#FFD0D2D8" FontSize="12"
                                    Width="26" Height="26" Padding="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- Reproducir/pausar en el naranja de la marca, igual que en Focus -->
                            <Button x:Name="PlayPauseButton" Content="&#xE768;"
                                    FontFamily="Segoe MDL2 Assets" Click="PlayPauseButton_Click"
                                    Width="30" Height="30" CornerRadius="15"
                                    Background="#FFFF5A00" Foreground="White" FontSize="13" BorderThickness="0"
                                    Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button.Resources>
                                    <!-- Que el botón siga naranja al pasar el cursor o presionarlo -->
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFF7A33"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFD94D00"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                                </Button.Resources>
                            </Button>
                            <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets"
                                    Click="NextButton_Click" Background="Transparent"
                                    Foreground="#FFD0D2D8" FontSize="12"
                                    Width="26" Height="26" Padding="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Barra de progreso interactiva -->
                    <Grid x:Name="ProgressTrack" Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedText" Text="00:00" Foreground="#FF858A96"
                                   FontSize="10" VerticalAlignment="Center"/>
                        <Grid x:Name="ProgressBarTrack" Grid.Column="1" Height="14" VerticalAlignment="Center"
                              Background="Transparent" SizeChanged="ProgressBarTrack_SizeChanged" Tapped="ProgressBarTrack_Tapped">
                            <Border Height="3" Background="#FF3A3C44" CornerRadius="1.5" VerticalAlignment="Center"/>
                            <Border x:Name="ProgressFill" Height="3" Background="#FFFFFFFF"
                                    CornerRadius="1.5" HorizontalAlignment="Left" Width="0" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="RemainingText" Grid.Column="2" Text="--:--"
                                   Foreground="#FF858A96" FontSize="10" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Letras sincronizadas (LRCLIB): línea actual y siguiente. Clic para saltar a esa línea. -->
                    <StackPanel x:Name="LyricsPanel" Grid.Row="2" Visibility="Collapsed" Spacing="1" Margin="0,6,0,0">
                        <TextBlock x:Name="LyricsCurrentLine" Text=" " FontSize="11" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" HorizontalAlignment="Center"
                                   Tapped="LyricsLine_Tapped" ToolTipService.ToolTip="Clic para ir a esta línea"/>
                        <TextBlock x:Name="LyricsNextLine" Text=" " FontSize="9.5" Foreground="#FF6F7480"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" HorizontalAlignment="Center"
                                   Tapped="LyricsLine_Tapped" ToolTipService.ToolTip="Clic para ir a esta línea"/>
                    </StackPanel>
                </Grid>

                <!-- ================= VISTA 2: DEV BACKLOG / TO-DO ================= -->
                <Grid x:Name="BacklogView" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Entrada rápida de backlog con tag dinámico y botón de adición -->
                    <Grid Grid.Row="0" Margin="0,1,0,6" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Chip de etiqueta ciclable (TODO -> FEAT -> FIX -> REFACTOR -> DOCS) -->
                        <Button x:Name="TagCycleButton"
                                Click="TagCycleButton_Click"
                                Height="26"
                                Padding="6,0"
                                CornerRadius="5"
                                Background="#FF1E2129"
                                BorderThickness="1"
                                BorderBrush="#FF323645"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentTagLabel" Text="TODO" FontSize="9.5" FontWeight="Bold" Foreground="#FF26A69A"/>
                        </Button>

                        <!-- Entrada de texto de la tarea -->
                        <TextBox x:Name="NewTaskInput"
                                 Grid.Column="1"
                                 Height="26"
                                 FontSize="11"
                                 PlaceholderText="Nueva tarea dev (ej: fix: bug en login...)"
                                 Background="#FF171920"
                                 Foreground="#FFF0F2F5"
                                 BorderBrush="#FF2F3342"
                                 BorderThickness="1"
                                 CornerRadius="5"
                                 Padding="7,2"
                                 KeyDown="NewTaskInput_KeyDown"/>

                        <!-- Botón añadir tarea -->
                        <Button x:Name="AddTaskButton"
                                Grid.Column="2"
                                Click="AddTaskButton_Click"
                                Height="26"
                                Width="26"
                                Padding="0"
                                CornerRadius="5"
                                Background="#FFFF5A00"
                                Foreground="#FF0A0B0E"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="11" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <!-- Lista con scroll sutil para los elementos del backlog -->
                    <ScrollViewer Grid.Row="1" Height="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TasksItemsPanel" Spacing="3"/>
                    </ScrollViewer>

                    <!-- Barra inferior de estado del backlog: conteo y acciones rápidas -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="BacklogSummaryText"
                                   Text="0 pendientes"
                                   FontSize="10"
                                   Foreground="#FF858A96"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Copiar en formato Markdown para PRs y commits -->
                            <Button x:Name="CopyMarkdownButton"
                                    Click="CopyMarkdownButton_Click"
                                    Height="21"
                                    Padding="6,0"
                                    CornerRadius="4"
                                    Background="#FF20222B"
                                    BorderThickness="1"
                                    BorderBrush="#FF323644">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="8.5" Foreground="#FFA5AAB8"/>
                                    <TextBlock x:Name="CopyMarkdownLabel" Text="Copiar MD" FontSize="9" Foreground="#FFA5AAB8" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <!-- Limpiar tareas completadas -->
                            <Button x:Name="ClearCompletedButton"
                                    Click="ClearCompletedButton_Click"
                                    Height="21"
                                    Padding="6,0"
                                    CornerRadius="4"
                                    Background="#FF20222B"
                                    BorderThickness="1"
                                    BorderBrush="#FF323644">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="8.5" Foreground="#FFEF5350"/>
                                    <TextBlock Text="Limpiar" FontSize="9" Foreground="#FFEF5350" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= VISTA 3: CALENDARIO Y AGENDA DEV ================= -->
                <Grid x:Name="CalendarView" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Fila 0: Barra superior de submodos [ Agenda | Semana | Mes ] + Navegación + [ + Evento ] + [ 🔄 Sync ] -->
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selector de submódo del calendario -->
                        <Border Background="#1AFFFFFF" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="1">
                                <Button x:Name="CalSubAgendaBtn" Click="CalSubAgendaBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="#FF2A2D37" BorderThickness="0">
                                    <TextBlock x:Name="CalSubAgendaLabel" Text="Agenda" FontSize="8.5" Foreground="White" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="CalSubWeekBtn" Click="CalSubWeekBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="Transparent" BorderThickness="0">
                                    <TextBlock x:Name="CalSubWeekLabel" Text="Semana" FontSize="8.5" Foreground="#FFA0A5B2"/>
                                </Button>
                                <Button x:Name="CalSubMonthBtn" Click="CalSubMonthBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="Transparent" BorderThickness="0">
                                    <TextBlock x:Name="CalSubMonthLabel" Text="Mes" FontSize="8.5" Foreground="#FFA0A5B2"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Navegación de fecha activa (< Día/Mes >) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="CalPrevDateBtn" Click="CalPrevDateBtn_Click" Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE76B;" FontSize="7.5" Foreground="#FFA0A5B2"/>
                            </Button>
                            <TextBlock x:Name="CalCurrentTitleLabel" Text="Hoy" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            <Button x:Name="CalNextDateBtn" Click="CalNextDateBtn_Click" Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE76C;" FontSize="7.5" Foreground="#FFA0A5B2"/>
                            </Button>
                        </StackPanel>

                        <!-- Botones de Acción: Nuevo Evento y Sincronización -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <Button x:Name="CalNewEventBtn" Click="CalNewEventBtn_Click" Height="21" Padding="6,0" CornerRadius="5" Background="#FFFF5A00" Foreground="#FF0A0B0E" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE710;" FontSize="8.5" FontWeight="Bold"/>
                                    <TextBlock Text="Evento" FontSize="8.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CalSyncBtn" Click="CalSyncBtn_Click" Height="21" Width="21" Padding="0" CornerRadius="5" Background="#FF222530" BorderThickness="1" BorderBrush="#FF323645">
                                <FontIcon Glyph="&#xE895;" FontSize="9" Foreground="#FFA0A5B2"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Fila 1: Área de contenido dinámico (Agenda, Semana o Mes) o Formularios Overlay -->
                    <Grid Grid.Row="1">
                        <!-- Panel 1: Agenda Diaria -->
                        <Grid x:Name="CalAgendaContainer" Visibility="Visible">
                            <ScrollViewer Height="136" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="AgendaEventsList" Spacing="3"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Panel 2: Tira Semanal + Agenda del día de la semana -->
                        <Grid x:Name="CalWeekContainer" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tira de 7 días de la semana -->
                            <Grid x:Name="WeekStripGrid" Grid.Row="0" Margin="0,0,0,4"/>
                            <!-- Lista de eventos del día seleccionado de la semana -->
                            <ScrollViewer Grid.Row="1" Height="102" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="WeekEventsList" Spacing="3"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Panel 3: Vista Mensual (Matriz de días) -->
                        <Grid x:Name="CalMonthContainer" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Encabezados de días (D L M M J V S) -->
                            <Grid x:Name="MonthDayHeadersGrid" Grid.Row="0" Margin="0,0,0,2"/>
                            <!-- Cuadrícula interactiva de 7 columnas x 5-6 filas -->
                            <Grid x:Name="MonthDaysGrid" Grid.Row="1" Height="120"/>
                        </Grid>

                        <!-- Panel 4: Formulario de Creación / Edición de Evento (Overlay) -->
                        <Grid x:Name="CalEventFormOverlay" Visibility="Collapsed" Background="#FF161820" CornerRadius="6" Padding="7,5">
                            <Grid.RenderTransform>
                                <TranslateTransform/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Título y categoría -->
                            <Grid Grid.Row="0" ColumnSpacing="5" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FormEventTitle" PlaceholderText="Título del evento o reunión..." Height="24" FontSize="10" Background="#FF1C1F28" Foreground="White" BorderBrush="#FF323645" CornerRadius="4" Padding="5,1"/>
                                <Button x:Name="FormCategoryBtn" Grid.Column="1" Click="FormCategoryBtn_Click" Height="24" Padding="5,0" CornerRadius="4" Background="#FF222530" BorderThickness="1" BorderBrush="#FF3A3F52">
                                    <TextBlock x:Name="FormCategoryLabel" Text="MEETING" FontSize="8" FontWeight="Bold" Foreground="#FF42A5F5"/>
                                </Button>
                            </Grid>

                            <!-- Fecha, Hora Inicio, Hora Fin -->
                            <Grid Grid.Row="1" ColumnSpacing="5" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FormEventDate" PlaceholderText="YYYY-MM-DD" Height="23" FontSize="9.5" Background="#FF1C1F28" Foreground="White" BorderBrush="#FF323645" CornerRadius="4" Padding="5,1"/>
                                <TextBox x:Name="FormStartTime" Grid.Column="1" Width="50" PlaceholderText="10:00" Height="23" FontSize="9.5" Background="#FF1C1F28" Foreground="White" BorderBrush="#FF323645" CornerRadius="4" Padding="4,1" TextChanged="FormTime_TextChanged"/>
                                <TextBox x:Name="FormEndTime" Grid.Column="2" Width="50" PlaceholderText="10:30" Height="23" FontSize="9.5" Background="#FF1C1F28" Foreground="White" BorderBrush="#FF323645" CornerRadius="4" Padding="4,1" TextChanged="FormTime_TextChanged"/>
                            </Grid>

                            <!-- Enlace videollamada + Vincular con Backlog -->
                            <Grid Grid.Row="2" ColumnSpacing="5" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FormMeetingUrl" PlaceholderText="Link Meet / Teams / Zoom..." Height="23" FontSize="9.5" Background="#FF1C1F28" Foreground="White" BorderBrush="#FF323645" CornerRadius="4" Padding="5,1"/>
                                <ComboBox x:Name="FormTaskLinkCombo" Grid.Column="1" PlaceholderText="Vincular con backlog..." Height="23" FontSize="9" Background="#FF1C1F28" BorderBrush="#FF323645" CornerRadius="4" HorizontalAlignment="Stretch"/>
                            </Grid>

                            <!-- Advertencia de Conflicto en vivo + Botones Guardar / Cancelar -->
                            <Grid Grid.Row="3" Margin="0,1,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FormConflictWarning" Text="" FontSize="8.5" Foreground="#FFFFA726" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button x:Name="FormCancelBtn" Click="FormCancelBtn_Click" Height="21" Padding="7,0" CornerRadius="4" Background="#FF282B36" Foreground="#FFA0A5B2" FontSize="9" BorderThickness="0">
                                        <TextBlock Text="Cancelar"/>
                                    </Button>
                                    <Button x:Name="FormSaveBtn" Click="FormSaveBtn_Click" Height="21" Padding="7,0" CornerRadius="4" Background="#FFFF5A00" Foreground="#FF0A0B0E" FontSize="9" FontWeight="Bold" BorderThickness="0">
                                        <TextBlock Text="Guardar"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Panel 5: Diálogo de Sincronización e Importación (Google / Outlook / iCal) -->
                        <Grid x:Name="CalSyncOverlay" Visibility="Collapsed" Background="#FF161820" CornerRadius="6" Padding="8,6">
                            <Grid.RenderTransform>
                                <TranslateTransform/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Fila 0: Encabezado (Título + Botón Cerrar) -->
                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="10" Foreground="#FFFF5A00"/>
                                    <TextBlock Text="Sincronización de Calendario" FontSize="9.5" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                                <Button x:Name="CloseSyncBtn" Grid.Column="1" Click="CloseSyncBtn_Click" Height="19" Width="19" Padding="0" CornerRadius="3" Background="#FF282B36" BorderThickness="0">
                                    <FontIcon Glyph="&#xE711;" FontSize="8" Foreground="#FFA0A5B2"/>
                                </Button>
                            </Grid>

                            <!-- Fila 1: Subtítulo (bien separado, sin sobreponerse) -->
                            <TextBlock Grid.Row="1" Text="Importa o exporta reuniones con Google Calendar u Outlook (.ics):" FontSize="8" Foreground="#FFA0A5B2" TextWrapping="Wrap" Margin="0,0,0,5"/>

                            <!-- Fila 2: Acciones de IMPORTACIÓN de reuniones -->
                            <Grid Grid.Row="2" ColumnSpacing="5" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ImportIcsFileBtn" Click="ImportIcsFileBtn_Click" Height="24" HorizontalAlignment="Stretch" CornerRadius="4" Background="#FF1C2633" BorderThickness="1" BorderBrush="#FF283E54">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="8.5" Foreground="#FF42A5F5"/>
                                        <TextBlock x:Name="ImportFileLabel" Text="Cargar archivo .ics" FontSize="8.5" Foreground="White" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ImportClipboardBtn" Grid.Column="1" Click="ImportClipboardBtn_Click" Height="24" HorizontalAlignment="Stretch" CornerRadius="4" Background="#FF1B2B24" BorderThickness="1" BorderBrush="#FF254C39">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE77F;" FontSize="8.5" Foreground="#FFFF5A00"/>
                                        <TextBlock x:Name="ImportClipboardLabel" Text="Pegar de Portapapeles" FontSize="8.5" Foreground="White" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Fila 3: Acciones de EXPORTACIÓN -->
                            <Grid Grid.Row="3" ColumnSpacing="5" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ExportIcsFileBtn" Click="ExportIcsFileBtn_Click" Height="24" HorizontalAlignment="Stretch" CornerRadius="4" Background="#FF222530" BorderThickness="1" BorderBrush="#FF3A3F52">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE896;" FontSize="8.5" Foreground="#FF42A5F5"/>
                                        <TextBlock x:Name="ExportIcsLabel" Text="Abrir en Outlook" FontSize="8.5" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CopyIcsBtn" Grid.Column="1" Click="CopyIcsBtn_Click" Height="24" HorizontalAlignment="Stretch" CornerRadius="4" Background="#FF222530" BorderThickness="1" BorderBrush="#FF3A3F52">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="8.5" Foreground="#FFFF5A00"/>
                                        <TextBlock x:Name="CopyIcsLabel" Text="Copiar .ics (Google)" FontSize="8.5" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Fila 4: Mensaje dinámico de Estado / Feedback -->
                            <TextBlock x:Name="SyncStatusMsg" Grid.Row="4" Text="" FontSize="8" Foreground="#FF00E676" FontWeight="SemiBold" TextAlignment="Center" Margin="0,3,0,0" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ================= VISTA 4: TEMPORIZADOR POMODORO / DEEP WORK ================= -->
                <Grid x:Name="PomodoroView" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Fila 0: Selector de Modo [ 🎯 Trabajo (25m) | ☕ Pausa (5m) | 🌴 Largo (15m) ] + Conteo -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#1AFFFFFF" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="1">
                                <Button x:Name="PomoModeWorkBtn" Click="PomoModeWorkBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="#FF2A2D37" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="8"/>
                                        <TextBlock x:Name="PomoModeWorkLabel" Text="Trabajo (25m)" FontSize="8.5" Foreground="White" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PomoModeShortBtn" Click="PomoModeShortBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="☕" FontSize="8"/>
                                        <TextBlock x:Name="PomoModeShortLabel" Text="Pausa (5m)" FontSize="8.5" Foreground="#FFA0A5B2"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PomoModeLongBtn" Click="PomoModeLongBtn_Click" CornerRadius="6" Padding="6,2" Height="20" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="🌴" FontSize="8"/>
                                        <TextBlock x:Name="PomoModeLongLabel" Text="Largo (15m)" FontSize="8.5" Foreground="#FFA0A5B2"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Contador de pomodoros completados hoy -->
                        <Border Grid.Column="1" Background="#20FF5A00" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="🍅" FontSize="8.5"/>
                                <TextBlock x:Name="PomodoroCompletedCountLabel" Text="0 hoy" FontSize="8.5" FontWeight="Bold" Foreground="#FFFF5A00"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Fila 1: Display del Temporizador Central + Barra de Progreso + Vínculo a Backlog -->
                    <Grid Grid.Row="1" Margin="0,2,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tiempo en formato grande y elegante con estado -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,2">
                            <TextBlock x:Name="PomodoroTimerDisplay" Text="25:00" FontSize="30" FontWeight="Bold" Foreground="#FFF5F5F7" HorizontalAlignment="Center" Margin="0,-4,0,-4"/>
                            <TextBlock x:Name="PomodoroStateSubtitle" Text="Sesión de Concentración" FontSize="9" Foreground="#FFA0A5B2" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Barra de progreso sutil del intervalo -->
                        <Grid x:Name="PomodoroTrackGrid" Grid.Row="1" Height="4" Margin="24,2,24,4" SizeChanged="PomodoroTrackGrid_SizeChanged">
                            <Border Background="#FF252833" CornerRadius="2"/>
                            <Border x:Name="PomodoroProgressBar" Background="#FFFF5A00" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                        </Grid>

                        <!-- Vínculo a tarea de Backlog -->
                        <Grid Grid.Row="2" ColumnSpacing="6" Margin="14,1,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎯 Tarea:" FontSize="8.5" Foreground="#FFA0A5B2" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PomoTaskLinkCombo" Grid.Column="1" Height="22" FontSize="8.5" PlaceholderText="Seleccionar tarea del backlog..." Background="#FF1A1C23" BorderBrush="#FF2F3342" CornerRadius="4" HorizontalAlignment="Stretch" SelectionChanged="PomoTaskLinkCombo_SelectionChanged"/>
                        </Grid>
                    </Grid>

                    <!-- Fila 2: Botones de Control (Play/Pause, Reset, Skip) -->
                    <Grid Grid.Row="2" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botón Reiniciar -->
                        <Button x:Name="PomoResetBtn" Grid.Column="0" Click="PomoResetBtn_Click" Height="23" Padding="8,0" CornerRadius="5" Background="#FF20232C" BorderThickness="1" BorderBrush="#FF323645" HorizontalAlignment="Right" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72C;" FontSize="8" Foreground="#FFA0A5B2"/>
                                <TextBlock Text="Reiniciar" FontSize="8.5" Foreground="#FFA0A5B2"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón Principal Play / Pause -->
                        <Button x:Name="PomoPlayPauseBtn" Grid.Column="1" Click="PomoPlayPauseBtn_Click" Width="34" Height="34" CornerRadius="17" Background="#FFFF5A00" Foreground="White" BorderThickness="0" HorizontalAlignment="Center">
                            <FontIcon x:Name="PomoPlayPauseIcon" Glyph="&#xE768;" FontSize="12" FontWeight="Bold"/>
                        </Button>

                        <!-- Botón Saltar Intervalo -->
                        <Button x:Name="PomoSkipBtn" Grid.Column="2" Click="PomoSkipBtn_Click" Height="23" Padding="8,0" CornerRadius="5" Background="#FF20232C" BorderThickness="1" BorderBrush="#FF323645" HorizontalAlignment="Left" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Saltar" FontSize="8.5" Foreground="#FFA0A5B2"/>
                                <FontIcon Glyph="&#xE893;" FontSize="8" Foreground="#FFA0A5B2"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ================= VISTA 5: SISTEMA Y RED (IT) ================= -->
                <Grid x:Name="SystemView" Grid.Row="2" Visibility="Collapsed" RowSpacing="6">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Fila 0: CPU, memoria, disco y tiempo encendido -->
                    <Grid ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FF1A1D25" CornerRadius="6" Padding="7,5">
                            <StackPanel Spacing="2">
                                <TextBlock Text="CPU" FontSize="8" Foreground="#FF858A96" FontWeight="Medium"/>
                                <TextBlock x:Name="SysCpuValue" Text="--" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="SysCpuDetail" Text=" " FontSize="7.5" Foreground="#FF858A96" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <Grid x:Name="SysCpuTrack" Height="3" Background="#FF2A2D37" CornerRadius="1.5" Margin="0,2,0,0">
                                    <Border x:Name="SysCpuBar" Background="#FF42A5F5" CornerRadius="1.5" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#FF1A1D25" CornerRadius="6" Padding="7,5">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Memoria" FontSize="8" Foreground="#FF858A96" FontWeight="Medium"/>
                                <TextBlock x:Name="SysRamValue" Text="--" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="SysRamDetail" Text=" " FontSize="7.5" Foreground="#FF858A96" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <Grid x:Name="SysRamTrack" Height="3" Background="#FF2A2D37" CornerRadius="1.5" Margin="0,2,0,0">
                                    <Border x:Name="SysRamBar" Background="#FFAB47BC" CornerRadius="1.5" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FF1A1D25" CornerRadius="6" Padding="7,5">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Disco" FontSize="8" Foreground="#FF858A96" FontWeight="Medium"/>
                                <TextBlock x:Name="SysDiskValue" Text="--" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="SysDiskDetail" Text=" " FontSize="7.5" Foreground="#FF858A96" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <Grid x:Name="SysDiskTrack" Height="3" Background="#FF2A2D37" CornerRadius="1.5" Margin="0,2,0,0">
                                    <Border x:Name="SysDiskBar" Background="#FFFFA726" CornerRadius="1.5" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#FF1A1D25" CornerRadius="6" Padding="7,5">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Encendido" FontSize="8" Foreground="#FF858A96" FontWeight="Medium"/>
                                <TextBlock x:Name="SysUptimeValue" Text="--" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="SysUptimeDetail" Text=" " FontSize="7.5" Foreground="#FF858A96" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <Grid x:Name="SysUptimeTrack" Height="3" Background="#FF2A2D37" CornerRadius="1.5" Margin="0,2,0,0">
                                    <Border x:Name="SysUptimeBar" Background="#FFFF5A00" CornerRadius="1.5" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Fila 1: Conexión principal, IP, VPN y latencia -->
                    <Border Grid.Row="1" Background="#FF1A1D25" CornerRadius="6" Padding="8,6">
                        <Grid ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon x:Name="SysNetIcon" Glyph="&#xE701;" FontSize="13" Foreground="#FF00E676" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SysNetTitle" Text="Comprobando red..." FontSize="10" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock x:Name="SysNetDetail" Text=" " FontSize="8.5" Foreground="#FF858A96" TextTrimming="CharacterEllipsis" MaxLines="1" IsTextSelectionEnabled="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border x:Name="SysVpnPill" Visibility="Collapsed" Background="#FF1E2A3D" CornerRadius="5" Padding="5,1" ToolTipService.ToolTip="VPN activa">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xE705;" FontSize="8" Foreground="#FF42A5F5"/>
                                        <TextBlock Text="VPN" FontSize="8" FontWeight="Bold" Foreground="#FF42A5F5"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="SysLatencyPill" Background="#FF222530" CornerRadius="5" Padding="5,1" ToolTipService.ToolTip="Latencia (ping)">
                                    <TextBlock x:Name="SysLatencyText" Text="-- ms" FontSize="8" FontWeight="Bold" Foreground="#FFA0A5B2"/>
                                </Border>
                                <Button x:Name="SysCopyInfoBtn" Click="SysCopyInfoBtn_Click" Height="20" Padding="5,0" CornerRadius="4" Background="#FF222530" BorderThickness="1" BorderBrush="#FF323645" ToolTipService.ToolTip="Copiar datos del equipo para un ticket">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="8" Foreground="#FFA5AAB8"/>
                                        <TextBlock x:Name="SysCopyInfoLabel" Text="Copiar" FontSize="8.5" Foreground="#FFA5AAB8"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= VISTA 6: SHELF DE ARCHIVOS Y TEXTOS ================= -->
                <Grid x:Name="ShelfView" Grid.Row="2" Visibility="Collapsed" RowSpacing="5">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ShelfSummary" Text="Arrastra archivos o texto a la isla" FontSize="9" Foreground="#FF858A96"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <Button x:Name="ShelfPasteBtn" Grid.Column="1" Click="ShelfPasteBtn_Click" Height="20" Padding="6,0" CornerRadius="4"
                                Background="#FF222530" BorderThickness="1" BorderBrush="#FF323645" ToolTipService.ToolTip="Agregar lo copiado (archivos o texto)">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE77F;" FontSize="8" Foreground="#FFA5AAB8"/>
                                <TextBlock Text="Pegar" FontSize="8.5" Foreground="#FFA5AAB8"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ShelfClearBtn" Grid.Column="2" Click="ShelfClearBtn_Click" Height="20" Padding="6,0" CornerRadius="4"
                                Background="#FF222530" BorderThickness="1" BorderBrush="#FF323645" ToolTipService.ToolTip="Quitar los seleccionados (o todos si no hay selección)">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE74D;" FontSize="8" Foreground="#FFA5AAB8"/>
                                <TextBlock x:Name="ShelfClearLabel" Text="Limpiar" FontSize="8.5" Foreground="#FFA5AAB8"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <GridView x:Name="ShelfGrid"
                                  SelectionMode="Extended"
                                  CanDragItems="True"
                                  DragItemsStarting="ShelfGrid_DragItemsStarting"
                                  SelectionChanged="ShelfGrid_SelectionChanged"
                                  Padding="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="ShelfEmptyHint" Text="Suelta aquí archivos, carpetas o texto.&#x0a;Solo se guarda su ubicación, no una copia."
                                   FontSize="9.5" Foreground="#FF6F7480" TextAlignment="Center" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
