<Window
    x:Class="AlexIsland.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Alex Island">

    <Grid Background="#FF090B10">
        <Border
            Width="320"
            Height="88"
            Padding="24,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,24,0,0"
            Background="#FF11151D"
            BorderBrush="#FF29313D"
            BorderThickness="1"
            CornerRadius="24">
            <StackPanel Spacing="6" VerticalAlignment="Center">
                <TextBlock
                    Text="ALEX ISLAND"
                    Foreground="#FFF5F7FA"
                    FontSize="16"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    Text="Base limpia · Windows 11"
                    Foreground="#FF9AA3B2"
                    FontSize="12"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
