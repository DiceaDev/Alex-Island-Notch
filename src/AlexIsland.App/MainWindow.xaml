<Window
    x:Class="AlexIsland.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Alex Island">

    <Grid Background="Transparent">
        <Button
            x:Name="IslandButton"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            PointerOverBackground="Transparent"
            PointerOverBorderBrush="Transparent"
            PressedBackground="Transparent"
            PressedBorderBrush="Transparent"
            Padding="0"
            IsTabStop="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Click="IslandButton_Click"
            AutomationProperties.Name="Expandir o contraer Alex Island">

            <Border
                x:Name="IslandSurface"
                Padding="22,14"
                Background="#FF111318"
                BorderBrush="#FF292D35"
                BorderThickness="1"
                CornerRadius="28">

                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="34"
                            Height="34"
                            VerticalAlignment="Center"
                            Background="#FF202A2B"
                            CornerRadius="17">
                            <FontIcon
                                Glyph="&#xE7F4;"
                                FontSize="16"
                                Foreground="#FF65D6AD"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Text="Alex Island"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#FFF5F7FA" />
                            <TextBlock
                                x:Name="StatusText"
                                Text="Núcleo iniciado · Windows 11"
                                FontSize="11"
                                Foreground="#FF9AA3B2" />
                        </StackPanel>

                        <Ellipse
                            Grid.Column="2"
                            Width="8"
                            Height="8"
                            Fill="#FF65D6AD"
                            VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel
                        x:Name="ExpandedPanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Spacing="8">
                        <Rectangle Height="1" Fill="#FF292D35" />
                        <TextBlock
                            Text="Panel de Alex Island"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#FFF5F7FA" />
                        <TextBlock
                            Text="La interfaz está activa. Las integraciones de Windows se incorporarán en la siguiente etapa."
                            TextWrapping="Wrap"
                            FontSize="11"
                            Foreground="#FF9AA3B2" />
                        <TextBlock
                            Text="Haz clic nuevamente para contraer"
                            FontSize="10"
                            Foreground="#FF65D6AD" />
                    </StackPanel>
                </Grid>
            </Border>
        </Button>
    </Grid>
</Window>
