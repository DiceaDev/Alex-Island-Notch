<Window x:Class="AlexIsland.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Alex Island">
  <Grid Background="Transparent">
    <Border Padding="22,14" Background="{ThemeResource IslandBackgroundBrush}" BorderBrush="#FF292D35" BorderThickness="1" CornerRadius="28">
      <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="34" Height="34" VerticalAlignment="Center" Background="#FF202A2B" CornerRadius="17">
          <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource IslandAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Alex Island" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource IslandForegroundBrush}"/>
          <TextBlock Text="Núcleo iniciado · Windows 11" FontSize="11" Foreground="{ThemeResource IslandMutedBrush}"/>
        </StackPanel>
        <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{ThemeResource IslandAccentBrush}" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
