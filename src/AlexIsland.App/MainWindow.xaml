<Window
    x:Class="AlexIsland.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Alex Island">

    <Grid Background="Transparent">
        <Border
            x:Name="IslandSurface"
            Background="#FF000000"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="0,0,18,18"
            IsTapEnabled="True"
            PointerEntered="IslandSurface_PointerEntered"
            PointerExited="IslandSurface_PointerExited"
            Tapped="IslandSurface_Tapped"
            AutomationProperties.Name="Alex Island">
            <Border.RenderTransform>
                <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>

            <Grid>
                <Grid x:Name="NotchContent" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Grid.Column="1"
                        Width="6"
                        Height="6"
                        Fill="#FF171A20"
                        Stroke="#FF252A32"
                        StrokeThickness="1"
                        VerticalAlignment="Top"
                        Margin="0,7,0,0" />
                </Grid>

                <Border x:Name="ExpandedContent" Visibility="Collapsed" Padding="22,14"><Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="34"
                            Height="34"
                            VerticalAlignment="Center"
                            Background="#FF202A2B"
                            CornerRadius="17">
                            <FontIcon
                                Glyph="&#xE7F4;"
                                FontSize="16"
                                Foreground="#FF65D6AD"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Text="Alex Island"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#FFF5F7FA" />
                            <TextBlock
                                x:Name="StatusText"
                                Text="Núcleo iniciado · Windows 11"
                                FontSize="11"
                                Foreground="#FF9AA3B2" />
                        </StackPanel>

                        <Ellipse
                            Grid.Column="2"
                            Width="8"
                            Height="8"
                            Fill="#FF65D6AD"
                            VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel
                        x:Name="ExpandedPanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Spacing="8">
                        <Rectangle Height="1" Fill="#FF292D35" />
                        <TextBlock
                            Text="Panel de Alex Island"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#FFF5F7FA" />
                        <TextBlock
                            Text="La interfaz está activa. Las integraciones de Windows se incorporarán en la siguiente etapa."
                            TextWrapping="Wrap"
                            FontSize="11"
                            Foreground="#FF9AA3B2" />
                        <TextBlock
                            Text="Haz clic para mantener abierto o cerrar el panel"
                            FontSize="10"
                            Foreground="#FF65D6AD" />
                    </StackPanel>
                </Grid></Border>
            </Grid>
        </Border>
    </Grid>
</Window>
