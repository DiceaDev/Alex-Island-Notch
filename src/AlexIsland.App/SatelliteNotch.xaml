<UserControl
    x:Class="AlexIsland.App.SatelliteNotch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Notch liviano de los monitores donde no está la isla completa: solo refleja
         su estado, sin temporizadores ni animaciones propias. -->
    <Grid x:Name="RootGrid">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="UserScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Grid x:Name="NotchContainer" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border x:Name="ShadowHost" IsHitTestVisible="False"/>
            <Path x:Name="NotchShape" Fill="#FF000000" Stroke="#1FFFFFFF" StrokeThickness="1"
                  HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- Reposo: los ojos del zorro -->
            <Grid x:Name="EyesContent" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32">
                <Ellipse Width="46" Height="22" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66FF5A00" Offset="0"/>
                            <GradientStop Color="#26FF5A00" Offset="0.55"/>
                            <GradientStop Color="#00FF5A00" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Polygon Points="0,0 4,1.2 10,8 5,6.4" Width="10" Height="8">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFB27A" Offset="0"/>
                                <GradientStop Color="#FFFF7A2E" Offset="0.5"/>
                                <GradientStop Color="#FFFF5A00" Offset="1"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                    </Polygon>
                    <Polygon Points="10,0 6,1.2 0,8 5,6.4" Width="10" Height="8">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFB27A" Offset="0"/>
                                <GradientStop Color="#FFFF7A2E" Offset="0.5"/>
                                <GradientStop Color="#FFFF5A00" Offset="1"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                    </Polygon>
                </StackPanel>
            </Grid>

            <!-- Música o Enfoque: dos líneas de texto -->
            <StackPanel x:Name="TextContent" Visibility="Collapsed" VerticalAlignment="Center" Margin="22,0,22,0" Spacing="0">
                <TextBlock x:Name="Line1Text" FontSize="11" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <TextBlock x:Name="Line2Text" FontSize="10" Foreground="#FFA0A5B2"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
