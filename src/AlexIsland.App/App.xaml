<Application x:Class="AlexIsland.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Naranja de Alex Island como color de acento de todos los controles -->
      <Color x:Key="SystemAccentColor">#FFFF5A00</Color>
      <Color x:Key="SystemAccentColorLight1">#FFFF7A33</Color>
      <Color x:Key="SystemAccentColorLight2">#FFFF9A66</Color>
      <Color x:Key="SystemAccentColorLight3">#FFFFBB99</Color>
      <Color x:Key="SystemAccentColorDark1">#FFD94D00</Color>
      <Color x:Key="SystemAccentColorDark2">#FFB34000</Color>
      <Color x:Key="SystemAccentColorDark3">#FF8C3200</Color>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="IslandBackgroundBrush" Color="#FF111318"/>
          <SolidColorBrush x:Key="IslandForegroundBrush" Color="#FFF5F7FA"/>
          <SolidColorBrush x:Key="IslandMutedBrush" Color="#FF9AA3B2"/>
          <SolidColorBrush x:Key="IslandAccentBrush" Color="#FFFF5A00"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
