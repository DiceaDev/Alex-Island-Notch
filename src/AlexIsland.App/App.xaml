<Application x:Class="AlexIsland.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Recursos estándar de los controles de WinUI -->
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Naranja de Alex Island como color de acento de todos los controles -->
      <Color x:Key="SystemAccentColor">#FFFA991C</Color>
      <Color x:Key="SystemAccentColorLight1">#FFFFB04A</Color>
      <Color x:Key="SystemAccentColorLight2">#FFFFC078</Color>
      <Color x:Key="SystemAccentColorLight3">#FFFFD08F</Color>
      <Color x:Key="SystemAccentColorDark1">#FFD9820F</Color>
      <Color x:Key="SystemAccentColorDark2">#FFB86E0E</Color>
      <Color x:Key="SystemAccentColorDark3">#FF8A5209</Color>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="IslandBackgroundBrush" Color="#FF032539"/>
          <SolidColorBrush x:Key="IslandForegroundBrush" Color="#FFFBF3F2"/>
          <SolidColorBrush x:Key="IslandMutedBrush" Color="#FFB8CBD3"/>
          <SolidColorBrush x:Key="IslandAccentBrush" Color="#FFFA991C"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
